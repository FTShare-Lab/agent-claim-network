{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -E '\\.rs$' && cargo fmt 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting Rust code..."
          }
        ]
      }
    ]
  }
}
