     def handle_version_rename(cls, data: Any) -> Any:
-        if isinstance(data, dict) and "version" in data:
+        if not isinstance(data, dict):
+            return data
+
+        if "version" in data:
             data.setdefault("schema_version", data.pop("version"))
+
+        # DeepSWE task.toml uses [agent].network_mode = "no-network".  Pier's
+        # execution isolation is expressed by [environment].allow_internet,
+        # with a model-domain allowlist restoring only inference egress.  Without
+        # this translation, Pydantic silently ignored the task policy and local
+        # Docker trials had unrestricted task internet access.
+        agent = data.get("agent")
+        if isinstance(agent, dict) and agent.get("network_mode") == "no-network":
+            environment = data.get("environment")
+            if not isinstance(environment, dict):
+                environment = {}
+                data["environment"] = environment
+            environment["allow_internet"] = False
