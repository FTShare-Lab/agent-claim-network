index 0000000..1c037d4
--- /dev/null
+++ b/tests/test_egress_proxy_cleanup.py
@@ -0,0 +1,21 @@
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from unittest.mock import Mock
+
+from pier.environments.docker.docker import DockerEnvironment
+
+
+def test_egress_proxy_credentials_are_kept_outside_trial_archive():
+    environment = object.__new__(DockerEnvironment)
+    environment.logger = Mock()
+    environment._egress_proxy_env = {"HTTPS_PROXY": "http://agent:token@example:8080"}
+    environment._egress_proxy_temp_dir = TemporaryDirectory()
+    temporary_dir = Path(environment._egress_proxy_temp_dir.name)
+    environment._egress_proxy_compose_path = temporary_dir / "docker-compose.json"
+    environment._egress_proxy_compose_path.write_text("credential")
+
+    environment._cleanup_egress_proxy_compose_file()
+
+    assert not temporary_dir.exists()
+    assert environment._egress_proxy_compose_path is None
+    assert environment._egress_proxy_env == {}
